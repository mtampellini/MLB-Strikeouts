# Next.js / Node
node_modules/
.next/
out/
.env
.env.local

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Backend caches — regeneratable, do NOT commit.
# Use `raw/*` (not `raw/`) so the `!file` exceptions below actually apply —
# a bare `raw/` rule git silently overrides any `!file` exception inside.
# Same trap that bit HR repo's first deploy.
backend/data/raw/*
# EXCEPT — player_id_cache.json (committed per backend/README.md, Phase 2 spec):
# small, expensive to rebuild via pybaseball, deterministic mappings.
!backend/data/raw/player_id_cache.json
# AND — cross-source disagreement log: tiny JSONL, useful diagnostic history.
!backend/data/raw/probables_disagreements.jsonl
# Use `processed/*` (not `processed/`) so `!file` exceptions below can
# unignore specific files. With a bare `processed/` rule git silently
# overrides any `!file` exceptions inside — burned us on HR repo's first deploy.
backend/data/processed/*
# EXCEPT — files explicitly committed:
# Static lookup tables used by the projection layer (Phase 3):
!backend/data/processed/league_averages_*.json
!backend/data/processed/park_factors.json
!backend/data/processed/park_k_factors.json
!backend/data/processed/park_k_factors_report.json
!backend/data/processed/umpire_k_factors.json
# Phase 4c output (sample-fit; current attempt FAILED gates, kept for diagnostic).
!backend/data/processed/feature_coefficients_*.json
# Phase 3-v2a output: pitcher archetypes (per-season + rolling 30-day classification)
# and diagnostic report (top-10 per archetype, YoY transitions, spot-check WARNs).
!backend/data/processed/pitcher_archetypes.json
!backend/data/processed/pitcher_archetypes_report.json
# Phase 3-v2b output: TTO multipliers (archetype x TTO bucket) + diagnostic report
# (heat map, 95% CI, research benchmark comparison, archetype interaction finding).
!backend/data/processed/tto_multipliers.json
!backend/data/processed/tto_multipliers_report.json
# nb_dispersion.json: locked value from scripts/fit_nb_dispersion.py.
!backend/data/processed/nb_dispersion.json
# tracker.json: generated nightly, read at build time for big-number cards.
!backend/data/processed/tracker.json

# DO commit backend/data/odds/ — those snapshots ARE our dataset.
# (No ignore rule for backend/data/odds.)

# Research artifacts (kept local; chunk caches are GBs)
backend/data/research/

# Run logs / scratch
backend/*.log
*.log

# backend/picks.json is a workflow intermediate — the cron writes it then
# copies to repo-root /picks.json (which IS tracked).
backend/picks.json
backend/secondary_picks.json
backend/shadow_picks.json
